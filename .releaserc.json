{
  "repositoryUrl": "git@github.com:centralnicgroup-opensource/rtldev-middleware-idna-uts46.git",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "HISTORY.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm run prepare"
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": [
          "HISTORY.md",
          "@(.releaserc|.sharedreleaserc|package?(-lock)).json",
          "release.config.js",
          "dist/index.mjs",
          "dist/index.cjs",
          "dist/index.bundle.js"
        ]
      }
    ],
    "@team-internet/semantic-release-plugins/teams-notify",
    "@semantic-release/github"
  ]
}
